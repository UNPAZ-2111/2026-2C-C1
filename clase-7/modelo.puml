@startuml

class Carta{
    - valor : int
    - palo : string
    + Carta(valor : int, palo : string)
    + getValor() : int
    + getPalo() : string
    + Descripcion() : string
    + esIgualA(otraCarta : Carta) : bool
}

class Jugador{
    - mano
    + Jugador()
    + RecibirCarta(unaCarta : Carta) : bool
    + ManoCompleta() : bool
    + Mostrar() : void
}

class Mazo{
    - cartas
    + Mazo() 
    + Generar() : void
    - Generar12Cartas(palo : string) : void
    + CantidadCartas() : int
    + QuitarCartaAlAzar() : Carta
    + Mostrar() : void
}

Program ..> Jugador
Program ..> Mazo
Mazo --> "<Carta> cartas" "List"
Mazo *- Random
Mazo - Carta
Jugador --> "<Carta> mano" "List"
Jugador - Carta


@enduml